<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Urzadzenie domowe"
        android:layout_gravity="center"
        android:textSize="24sp"/>

    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="Autor: 67" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imageView4"
                android:layout_width="175dp"
                android:layout_height="175dp"
                android:layout_margin="25dp"
                app:srcCompat="@drawable/pralka" />

            <ImageView
                android:id="@+id/imageView6"
                android:layout_width="175dp"
                android:layout_height="175dp"
                android:layout_margin="25dp"
                app:srcCompat="@drawable/odkurzacz" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textView2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pralka" />

            <EditText
                android:id="@+id/editTextNumberPralka"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ems="10"
                android:inputType="number" />

            <Button
                android:id="@+id/buttonZatwierdzPralka"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Zatwierdź" />

            <TextView
                android:id="@+id/textViewOutputPralka"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TextView" />

            <TextView
                android:id="@+id/textView4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Odkurzacz"
                android:layout_marginTop="120dp"/>

            <Button
                android:id="@+id/buttonOdkurzaczOnOff"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Button" />

            <TextView
                android:id="@+id/textViewOdkurzaczOnOff"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TextView" />

            <TextView
                android:id="@+id/textView6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Status: naładowany" />

        </LinearLayout>
    </LinearLayout>


</LinearLayout>